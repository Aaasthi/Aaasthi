generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(uuid())
  name      String?
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}

model Service {
  id         String  @id @default(uuid())
  title      String
  description String
  icon       String?
  orderIndex Int?
}

model BlogPost {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  content      String
  featuredImage String?
  createdAt    DateTime @default(now())
}
